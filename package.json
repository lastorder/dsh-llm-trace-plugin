{
  "name": "dsh-llm-trace-plugin",
  "version": "0.2.1",
  "description": "Capture the literal HTTP request/response of every LLM provider call (by patching globalThis.fetch) and show them in a Wire Trace session tab",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "main": "dist/host/index.js",
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "test",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.host.json && node build-client.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\"",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "clean": "rm -rf dist .test-build"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lastorder/dsh-llm-trace-plugin.git"
  },
  "homepage": "https://github.com/lastorder/dsh-llm-trace-plugin#readme",
  "bugs": {
    "url": "https://github.com/lastorder/dsh-llm-trace-plugin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "llm",
    "trace",
    "debugging"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
