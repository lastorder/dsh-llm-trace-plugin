{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".test-build",
    "rootDir": ".",
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/host/**/*.ts",
    "src/shared/**/*.ts",
    "src/client/constants.ts",
    "src/client/format.ts",
    "src/client/json-model.ts",
    "src/client/sse.ts",
